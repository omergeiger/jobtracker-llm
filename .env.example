# Hugging Face Inference API
# Get your token at https://huggingface.co/settings/tokens (Read token is sufficient)
HF_API_TOKEN=hf_...

# Model used for LLM scoring (via router.huggingface.co)
# meta-llama/Llama-3.1-8B-Instruct is the tested default (fast, ~1s/post on featherless-ai).
# Qwen/Qwen2.5-7B-Instruct is an alternative but has been unreliable on featherless-ai.
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Inference provider — must support the chosen model.
# featherless-ai supports Llama-3.1-8B-Instruct reliably.
HF_PROVIDER=featherless-ai

# Daily email report (Gmail SMTP)
# GMAIL_APP_PASSWORD is a Google App Password (not your login password).
# Generate one at: myaccount.google.com → Security → 2-Step Verification → App passwords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# REPORT_RECIPIENT defaults to GMAIL_USER if not set
# REPORT_RECIPIENT=other@example.com
